        "$ref": "#/components/headers/X-Request-Id"
       }
      },
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "items",
          "next_cursor"
         ],
         "properties": {
          "items": {
           "type": "array",
           "items": {
            "type": "object",
            "additionalProperties": true
           }
          },
          "next_cursor": {
           "type": [
            "string",
            "null"
           ]
          },
          "errors": {
           "type": "array",
           "items": {
            "type": "object",
            "additionalProperties": true
           }
          }
         }
        }
       }
      }
     },
     "304": {
      "description": "Not changed since the ETag sent in If-None-Match."
     },
     "401": {
