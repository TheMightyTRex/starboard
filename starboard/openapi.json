     },
     "429": {
      "$ref": "#/components/responses/Problem"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "key": {
    "type": "http",
    "scheme": "bearer",
    "description": "A Starboard API key, sb_read_..."
   }
  },
  "parameters": {
   "limit": {
    "name": "limit",
    "in": "query",
    "schema": {
     "type": "integer",
     "minimum": 1,
     "maximum": 200,
     "default": 50
    },
    "description": "How many to give back."
   },
   "cursor": {
    "name": "cursor",
    "in": "query",
    "schema": {
     "type": "string"
    },
    "description": "The next_cursor of the previous answer."
   }
  },
  "headers": {
   "ETag": {
    "schema": {
     "type": "string"
    },
    "description": "Send it back in If-None-Match."
   },
   "X-Request-Id": {
    "schema": {
     "type": "string"
    },
    "description": "Yours, or one Starboard made; also in problem.instance."
   }
  },
  "responses": {
   "Problem": {
    "description": "RFC 9457 problem details.",
    "content": {
     "application/problem+json": {
      "schema": {
       "$ref": "#/components/schemas/Problem"
      }
     }
    }
   }
  },
  "schemas": {
   "Root": {
    "type": "object",
    "required": [
     "api_version",
     "starboard_version",
     "links"
    ],
    "properties": {
     "api_version": {
      "type": "string"
     },
     "starboard_version": {
      "type": "string"
     },
     "links": {
      "type": "object"
     }
    }
   },
   "Key": {
    "type": "object",
    "required": [
     "id",
     "name",
     "right",
     "scopes",
     "created_at",
     "prefix"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "right": {
      "type": "string",
      "enum": [
       "read"
      ]
     },
     "scopes": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "apps",
        "downloads",
        "media",
        "system"
       ]
      }
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "expires_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "last_used_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "prefix": {
      "type": "string"
     }
    }
   },
   "App": {
    "type": "object",
    "required": [
     "id",
     "name",
     "type",
     "group",
     "enabled",
     "url",
     "api_key_set"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "group": {
      "type": "string"
     },
     "enabled": {
      "type": "boolean"
     },
     "url": {
      "type": "string"
     },
     "api_key_set": {
      "type": "boolean"
     }
    }
   },
   "Problem": {
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "properties": {
     "type": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "status": {
      "type": "integer"
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string"
     },
     "code": {
      "type": "string"
     }
    }
   }
  }
 }
}
