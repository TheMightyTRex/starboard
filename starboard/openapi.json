{
 "openapi": "3.1.0",
 "info": {
  "title": "Starboard API",
  "version": "1.0.0",
  "description": "Read only for now. Make a key in Starboard: Settings, Security, API keys. Send it as Authorization: Bearer sb_read_... Errors are RFC 9457 problem details. Lists use limit and cursor. Answers carry an ETag; send If-None-Match to get 304.",
  "license": {
   "name": "MIT",
   "identifier": "MIT"
  }
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "security": [
  {
   "key": []
  }
 ],
 "paths": {
  "/api/v1/": {
   "get": {
    "operationId": "getRoot",
    "summary": "The API's version, Starboard's version and links",
    "tags": [
     "About"
    ],
    "responses": {
     "200": {
      "description": "It worked.",
      "headers": {
       "ETag": {
        "$ref": "#/components/headers/ETag"
       },
       "X-Request-Id": {
        "$ref": "#/components/headers/X-Request-Id"
       }
      },
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Root"
        }
       }
      }
     },
     "304": {
      "description": "Not changed since the ETag sent in If-None-Match."
     },
     "401": {
      "$ref": "#/components/responses/Problem"
     },
     "429": {
      "$ref": "#/components/responses/Problem"
     }
    }
   }
  },
  "/api/v1/me": {
   "get": {
    "operationId": "getMe",
    "summary": "The key you are using: its name, right and scopes",
    "tags": [
     "About"
    ],
    "responses": {
     "200": {
      "description": "It worked.",
