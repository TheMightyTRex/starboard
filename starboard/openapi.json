     "401": {
      "$ref": "#/components/responses/Problem"
     },
     "429": {
      "$ref": "#/components/responses/Problem"
     }
    }
   }
  },
  "/api/v1/apps/{id}": {
   "get": {
    "operationId": "getApp",
    "summary": "One app",
    "tags": [
     "Apps"
    ],
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
