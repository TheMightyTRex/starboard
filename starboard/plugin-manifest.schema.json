{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://starboard.invalid/plugin-manifest-1.json",
 "title": "Starboard plug-in manifest, version 1",
 "type": "object",
 "additionalProperties": false,
 "$defs": {
  "colours": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "bg",
    "header",
    "surface",
    "surface_raised",
    "surface_sunken",
    "text",
    "text_muted",
    "border",
    "divider",
    "accent",
    "accent_text",
    "accent_soft",
    "focus"
   ],
   "patternProperties": {
    "^[a-z_]+$": {
     "type": "string",
     "pattern": "^#[0-9a-fA-F]{6}$"
    }
   }
  }
 },
 "required": [
  "author",
  "description",
  "homepage",
  "id",
  "licence",
  "manifest_version",
  "name",
  "permissions",
  "starboard_api",
  "support_url",
  "version"
 ],
 "properties": {
  "manifest_version": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$"
  },
  "name": {
   "type": "string",
   "maxLength": 40
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
  },
  "description": {
   "type": "string",
   "maxLength": 200
  },
  "author": {
   "type": "string",
   "maxLength": 60
  },
  "licence": {
   "type": "string",
   "pattern": "^[A-Za-z0-9.+-]{2,40}$"
  },
  "homepage": {
   "type": "string",
   "pattern": "^https://"
  },
  "support_url": {
   "type": "string",
   "pattern": "^https://"
  },
  "starboard_api": {
   "type": "string"
  },
  "health": {
   "type": "string",
   "pattern": "^/"
  },
  "permissions": {
   "type": "array",
   "items": {
    "enum": [
     "appearance:styles",
     "apps:read",
     "downloads:read",
     "jellyfin:key",
     "media:read",
     "network:lan",
     "network:vpn",
     "reelix:key",
     "system:read",
     "usenet:servers"
    ]
   },
   "uniqueItems": true
  },
  "needs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "styles": {
   "type": "array",
   "minItems": 1,
   "maxItems": 32,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "light",
     "dark"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string",
      "maxLength": 30
     },
     "description": {
      "type": "string",
      "maxLength": 120
     },
     "radius": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24
     },
     "font": {
      "enum": [
       "hyperlegible",
       "system",
       "rounded",
       "serif",
       "mono"
      ]
     },
     "shadow": {
      "enum": [
       "none",
       "soft",
       "strong",
       "layered",
       "glow",
       "clay",
       "hairline"
      ]
     },
     "card_style": {
      "enum": [
       "flat",
       "outlined",
       "elevated",
       "tonal"
      ]
     },
     "button_fill": {
      "enum": [
       "solid",
       "outline",
       "soft",
       "ghost"
      ]
     },
     "border_width": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "tab_style": {
      "enum": [
       "underline",
       "pill",
       "boxed"
      ]
     },
     "header_style": {
      "enum": [
       "solid",
       "blurred",
       "accent_bar",
       "rule"
      ]
     },
     "rail_style": {
      "enum": [
       "solid",
       "floating",
       "tinted"
      ]
     },
     "chip_style": {
      "enum": [
       "soft",
       "outline"
      ]
     },
     "heading_case": {
      "enum": [
       "none",
       "labels"
      ]
     },
     "heading_tracking": {
      "enum": [
       "tight",
       "normal",
       "wide"
      ]
     },
     "primary_gradient": {
      "type": "boolean"
     },
     "heading_font": {
      "enum": [
       "hyperlegible",
       "system",
       "rounded",
       "serif",
       "mono"
      ]
     },
     "heading_weight": {
      "enum": [
       600,
       700,
       800
      ]
     },
     "focus_width": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
     },
     "gradient": {
      "enum": [
       "none",
       "linear",
       "radial",
       "mesh"
      ]
     },
     "gradient_angle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 360
     },
     "texture": {
      "enum": [
       "none",
       "dots",
       "grid",
       "lines",
       "grain"
      ]
     },
     "glass": {
      "type": "boolean"
     },
     "rounded_controls": {
      "type": "boolean"
     },
     "light": {
      "$ref": "#/$defs/colours"
     },
     "dark": {
      "$ref": "#/$defs/colours"
     }
    }
   }
  },
  "containers": {
   "type": "array",
   "minItems": 0,
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "image"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "image": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+(:\\d+)?(/[a-z0-9._-]+)+@sha256:[0-9a-f]{64}$"
     },
     "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
     },
     "network": {
      "enum": [
       "default",
       "lan",
       "vpn"
      ]
     },
     "publish": {
      "type": "boolean"
     },
     "volumes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "env": {
      "type": "object"
     },
     "start": {
      "enum": [
       "always",
       "when_needed"
      ]
     },
     "idle_stop_minutes": {
      "type": "integer"
     },
     "user": {
      "type": "string",
      "pattern": "^[1-9]\\d{0,5}:\\d{1,6}$"
     }
    }
   }
  },
  "resources": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "memory": {
      "type": "integer",
      "maximum": 512
     },
     "cpus": {
      "type": "number",
      "maximum": 1.0
     }
    }
   }
  },
  "settings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "key",
     "label",
     "type"
    ],
    "properties": {
     "type": {
      "enum": [
       "text",
       "number",
       "switch",
       "choice",
       "address",
       "secret",
       "folder",
       "list",
       "custom"
      ]
     },
     "required": {
      "type": "boolean"
     },
     "group": {
      "type": "string",
      "maxLength": 40
     },
     "choices": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "array",
        "items": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "object",
           "required": [
            "value",
            "label"
           ],
           "additionalProperties": false,
           "properties": {
            "value": {
             "type": "string"
            },
            "label": {
             "type": "string",
             "maxLength": 60
            }
           }
          }
         ]
        }
       }
      ]
     }
    }
   }
  },
  "cards": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "type",
     "path"
    ],
    "properties": {
     "type": {
      "enum": [
       "stat",
       "list",
       "status",
       "guide"
      ]
     },
     "format": {
      "enum": [
       "number",
       "bytes",
       "percent",
       "duration",
       "date"
      ]
     },
     "refresh_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
     }
    }
   }
  },
  "setup_required": {
   "type": "boolean"
  },
  "notices": {
   "type": "array",
   "items": {
    "enum": [
     "adult",
     "p2p"
    ]
   },
   "uniqueItems": true
  },
  "events": {
   "type": "array",
   "items": {
    "enum": [
     "app.down",
     "app.up",
     "download.finished",
     "item.added",
     "playback.started"
    ]
   },
   "uniqueItems": true
  },
  "jobs": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "label",
     "path"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
     },
     "label": {
      "type": "string",
      "maxLength": 60
     },
     "path": {
      "type": "string",
      "pattern": "^/"
     },
     "daily": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
     },
     "every_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
     },
     "at_start": {
      "const": true
     },
     "time_limit_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
     },
     "quiet_hours": {
      "type": "boolean"
     }
    }
   }
  },
  "actions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "label",
     "path"
    ]
   }
  },
  "changes": {
   "type": "array",
   "minItems": 1,
   "maxItems": 20,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "version"
    ],
    "properties": {
     "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "added": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 300
      }
     },
     "changed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 300
      }
     },
     "deprecated": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 300
      }
     },
     "removed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 300
      }
     },
     "fixed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 300
      }
     },
     "security": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 300
      }
     }
    }
   }
  }
 }
}
