# Copy to .env (the installer does this). .env is ignored by git.

# Port to listen on.
STARBOARD_PORT=8095

# First run only: 1 = phones and computers on your home network can open it, 0 = this computer only.
# After that, change it in Settings, Security.
STARBOARD_NETWORK=1

TZ=Etc/UTC

# Optional: "owner/name" of the GitHub repository, so Settings can say when a new release is out.
STARBOARD_REPO=

# Optional: free space on the System page. Label=path inside the container, separated by commas.
# Mount each path read-only in compose.yaml first.
STARBOARD_DISKS=

# Optional: Disk health. The folder (inside the container) where the SMART job saves its reports.
STARBOARD_SMART_DIR=

# Optional: Drive pools. The folder (inside the container) where the pool helper answers (deploy/install-pool.sh).
STARBOARD_POOL_DIR=

# Optional: Backup and restore. A host backup job's folder (with requests/ inside) and where it saves files.
STARBOARD_JOBS_DIR=
STARBOARD_BACKUP_DIR=

# Set to 1 only when Starboard sits behind your own reverse proxy. It then believes X-Forwarded-* headers, but
# only from the proxy: this computer, or the addresses in STARBOARD_PROXY_ADDRESSES (separated by commas).
STARBOARD_TRUST_PROXY=0
STARBOARD_PROXY_ADDRESSES=

# Starboard answers to IP addresses, localhost and this computer's name. Add any other name you use to open it,
# such as dashboard.example.com, or .example.com for every name under it (separated by commas).
STARBOARD_ALLOWED_HOSTS=

# Storyarr was retired on 11 November 2026 and is no longer offered. Only for an install that has it already: the
# Storyarr image to keep. Empty: ghcr.io/themightytrex/storyarr at a pinned version.
STARBOARD_STORYARR_IMAGE=
