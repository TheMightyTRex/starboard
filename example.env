# Copy to .env (the installer does this). .env is ignored by git.

# Address and port to listen on. 127.0.0.1 = this computer only. 0.0.0.0 = everyone on your network.
STARBOARD_BIND=127.0.0.1
STARBOARD_PORT=8095

TZ=Etc/UTC

# Optional: "owner/name" of the GitHub repository, so Settings can say when a new release is out.
STARBOARD_REPO=

# Optional: free space on the System page. Label=path inside the container, separated by commas.
# Mount each path read-only in compose.yaml first.
STARBOARD_DISKS=

# Set to 1 only when Starboard sits behind your own reverse proxy (it then trusts X-Forwarded-* headers).
STARBOARD_TRUST_PROXY=0
