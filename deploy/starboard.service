# Written by install.sh --native. Runs as your user; settings in @DIR@/data.
[Unit]
Description=Starboard dashboard
After=network-online.target

[Service]
WorkingDirectory=@DIR@
Environment=STARBOARD_PORT=@PORT@
Environment=STARBOARD_DATA=@DIR@/data
# Two memory pools for all of Starboard's threads, not one each (DASH-298); the Docker image uses Alpine's allocator, which has no such setting.
Environment=MALLOC_ARENA_MAX=2
EnvironmentFile=-@DIR@/.env
ExecStart=/usr/bin/env python3 -m starboard
Restart=on-failure
NoNewPrivileges=true
# The same limits as compose.yaml: a fault cannot take the whole computer's memory or processes.
MemoryMax=512M
TasksMax=200
UMask=0077

[Install]
WantedBy=default.target
