{
 "manifest_version": 1,
 "id": "page-parts",
 "name": "Page parts example",
 "version": "1.0.0",
 "description": "An example of the shared wizard, a sentence with selects, media cards and a preview on a plug-in page.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://example.invalid/page-parts",
 "support_url": "https://example.invalid/page-parts/issues",
 "starboard_api": ">=1.25 <2.0",
 "permissions": [
  "network:lan"
 ],
 "health": "/health",
 "containers": [
  {
   "name": "main",
   "image": "ghcr.io/example/page-parts@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
   "port": 8080,
   "network": "lan",
   "volumes": [
    "data"
   ],
   "start": "when_needed"
  }
 ],
 "settings": [
  {
   "key": "setup",
   "label": "Set up the breaks",
   "type": "custom",
   "choices": "/screen/setup"
  },
  {
   "key": "sentence",
   "label": "In a sentence",
   "type": "custom",
   "choices": "/screen/sentence"
  },
  {
   "key": "library",
   "label": "Clips and music",
   "type": "custom",
   "choices": "/screen/library"
  }
 ]
}
